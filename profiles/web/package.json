{
  "name": "dsh-profile-web",
  "private": true,
  "dependencies": {
    "@dennisrongo/dsh-memory": "^0.1.2",
    "@dsh-external/dsh-sidechain": "git+https://github.com/Buyi-wsgzg/dsh-sidechain.git",
    "@local/dsh-locale-uk": "workspace:*",
    "dsh-recall": "^0.3.0",
    "dsh-session-fork": "^0.2.0",
    "dsh-thinking-language": "github:qingmomo233/dsh-thinking-language",
    "dshmarket": "^1.41.0"
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/dsh-tools": "link:../../node_modules/@deepseek-ai/dsh-tools",
      "@deepseek-ai/dsh-settings": "link:../../node_modules/@deepseek-ai/dsh-settings",
      "@deepseek-ai/schemastery": "link:../../node_modules/@deepseek-ai/schemastery",
      "@deepseek-ai/cosmokit": "link:../../node_modules/@deepseek-ai/cosmokit"
    }
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "dshmarket",
        "@dennisrongo/dsh-memory",
        "@dsh-external/dsh-sidechain",
        "dsh-recall",
        "dsh-session-fork",
        "dsh-thinking-language"
      ]
    }
  }
}
